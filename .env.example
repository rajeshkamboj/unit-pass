# UnitPass environment variables.
# Copy to .env.local for local development:  cp .env.example .env.local
# Never commit real values. Secrets must NOT be prefixed with NEXT_PUBLIC_.

# Public origin of the app (used for auth redirects, links and QR payloads in later phases).
# Local: http://localhost:3000   Production: your real domain (must be correct BEFORE printing QR labels).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Dashboard -> Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Postgres connection string used ONLY by migration/test scripts (never by the app at runtime).
# Supabase Dashboard -> Project Settings -> Database -> Connection string (URI).
SUPABASE_DB_URL=
